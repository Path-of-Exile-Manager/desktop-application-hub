# Скопируйте в .env.local (он не попадает в git) и поменяйте значения.

# Режим разработки: пометка Dev в интерфейсе, Админка и Витрина в навигации.
# true / false
DEVELOPMENT=true

# Адрес сервера (BFF). Приложение проверяет GET {API_URL}/v1/health.
# Пока бэкенда нет — тестовый сервер: pnpm mock:api
# В Админке (режим Development) адрес можно поменять без перезапуска.
API_URL=http://localhost:8787
