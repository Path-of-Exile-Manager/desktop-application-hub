# Скопируйте в .env.local (он не попадает в git) и поменяйте значения.
# Инструменты разработчика включаются в самом приложении: Настройки → «Режим разработчика».

# Адрес сервера (BFF). Приложение проверяет GET {API_URL}/v1/health.
# Пока бэкенда нет — тестовый сервер: pnpm mock:api
# На странице «Режим разработки» адрес можно поменять без перезапуска.
API_URL=http://localhost:8787

# Discord-приложение (Developer Portal → General Information → Application ID).
# Публичный id, не секрет: по нему показывается статус в Discord и работают приглашения.
# Пока его нет — Rich Presence выключен. Прототип: cargo run -p discord-presence --example spike
DISCORD_CLIENT_ID=
