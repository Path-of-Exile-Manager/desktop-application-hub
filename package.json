{
  "name": "poe-manager-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tokens": "node scripts/build-tokens.mjs",
    "mock:api": "node scripts/mock-api.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --workspace",
    "gen:types": "cargo test -p poe-manager --lib export_bindings",
    "check": "tsc && node scripts/check-tokens.mjs && vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/api": "^2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
